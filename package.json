{
	"name": "dsh-notify-yimit",
	"version": "0.2.2",
	"description": "DeepSeek Harness 通知插件:任务完成 / 任务出错 / 运行中(实时活动)/ 等待审批 / 等待回答 时,通过 Windows 系统通知或插件自定义样式通知提醒用户,支持点击跳转到对应会话;设置页集成在 DSH 设置界面。",
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": {
			"default": "./lib/index.js"
		},
		"./client": {
			"default": "./lib/client.js"
		},
		"./typert": {
			"default": "./lib/typert.host.js"
		},
		"./package.json": "./package.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-api-remotes",
				"@deepseek-ai/dsh-client-locale"
			],
			"platform": "web"
		}
	},
	"files": [
		"lib/index.js",
		"lib/typert.host.js",
		"lib/client.js",
		"lib/toast-host.ps1",
		"cordis.patch.yml",
		"README.md",
		"README.en.md"
	],
	"scripts": {
		"prepublishOnly": "node -e \"const bad = Object.keys(require('./package.json').dependencies || {}).filter((k) => k.startsWith('@deepseek-ai/')); if (bad.length) throw new Error('host packages belong in peerDependencies: ' + bad.join(', '))\""
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/YiMlT/dsh-notify-yimit"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.3.0-0"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-client-locale": {
			"optional": false
		}
	},
	"keywords": [
		"deepseek", "deepseek-harness", "dsh", "dsh-plugin", "client-plugin", "notify", "notification", "toast"
	],
	"license": "MIT"
}
